  <div
    class="ant-picker ant-picker-range ant-picker-outlined css-var-root ant-picker-css-var"
    style="width: 200px;"
  >
    <div
      class="ant-picker-input ant-picker-input-active ant-picker-input-start"
    >
      <input
        aria-invalid="false"
        autocomplete="off"
        date-range="start"
        placeholder="Pradžios data"
        size="12"
        value=""
      />
    </div>
    <div
      class="ant-picker-range-separator"
    >
      <span
        aria-hidden="true"
        class="ant-picker-separator"
      >
        <span
          aria-label="swap-right"
          class="anticon anticon-swap-right"
          role="img"
        >
          <svg
            aria-hidden="true"
            data-icon="swap-right"
